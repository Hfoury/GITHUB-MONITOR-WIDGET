<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:gravity="center_horizontal" android:padding="10dp" android:background="#192C76">
 <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SUIVI GITHUB" android:gravity="center" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp"/>
 <TextView android:id="@+id/updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="En attente d'actualisation" android:gravity="center" android:textColor="#93DAFE" android:textSize="10sp" android:paddingBottom="3dp"/>
 <LinearLayout android:id="@+id/repo1_card" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingTop="1dp" android:paddingBottom="1dp">
  <TextView android:id="@+id/repo1_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Boulangeries-France : —" android:gravity="center" android:textColor="#FFFFFF" android:textSize="12sp" android:maxLines="2"/>
  <ProgressBar android:id="@+id/repo1_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="7dp" android:max="100" android:progress="0" android:progressTint="#FF7403" android:progressBackgroundTint="#52649B"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/repo2_card" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingTop="1dp" android:paddingBottom="1dp">
  <TextView android:id="@+id/repo2_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Stations-Total-France : —" android:gravity="center" android:textColor="#FFFFFF" android:textSize="12sp" android:maxLines="2"/>
  <ProgressBar android:id="@+id/repo2_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="7dp" android:max="100" android:progress="0" android:progressTint="#FF7403" android:progressBackgroundTint="#52649B"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/repo3_card" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingTop="1dp" android:paddingBottom="1dp">
  <TextView android:id="@+id/repo3_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Iriscope : —" android:gravity="center" android:textColor="#FFFFFF" android:textSize="12sp" android:maxLines="2"/>
  <ProgressBar android:id="@+id/repo3_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="7dp" android:max="100" android:progress="0" android:progressTint="#FF7403" android:progressBackgroundTint="#52649B"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/repo4_card" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingTop="1dp" android:paddingBottom="1dp" android:visibility="gone">
  <TextView android:id="@+id/repo4_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Repository 4" android:gravity="center" android:textColor="#FFFFFF" android:textSize="12sp" android:maxLines="2"/>
  <ProgressBar android:id="@+id/repo4_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="7dp" android:max="100" android:progress="0" android:progressTint="#FF7403" android:progressBackgroundTint="#52649B"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/repo5_card" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingTop="1dp" android:paddingBottom="1dp" android:visibility="gone">
  <TextView android:id="@+id/repo5_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Repository 5" android:gravity="center" android:textColor="#FFFFFF" android:textSize="12sp" android:maxLines="2"/>
  <ProgressBar android:id="@+id/repo5_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="7dp" android:max="100" android:progress="0" android:progressTint="#FF7403" android:progressBackgroundTint="#52649B"/>
 </LinearLayout>
 <TextView android:id="@+id/monitor_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Surveillance inactive" android:gravity="center" android:textColor="#93DAFE" android:textSize="10sp" android:paddingTop="3dp" android:paddingBottom="4dp"/>
 <Button android:id="@+id/refresh" android:layout_width="match_parent" android:layout_height="38dp" android:text="ACTUALISER" android:textAllCaps="true" android:textSize="12sp" android:textColor="#FFFFFF" android:backgroundTint="#FF7403"/>
</LinearLayout>
